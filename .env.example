# Athlete OS — environment template. PLACEHOLDERS ONLY; never commit real values.
# Copy to `supabase/functions/.env` for local function runs, or set each value
# with `supabase secrets set NAME=value` for deployed functions.
#
# CLIENT-PUBLIC values (safe to ship in the app) do NOT go here: put them in
# config/dev.json (see config/dev.example.json) and run
#   flutter run --dart-define-from-file=config/dev.json
# Client-public: SUPABASE_URL, SUPABASE_ANON_KEY, STRAVA_CLIENT_ID,
#                GOOGLE_WEB_CLIENT_ID, OFF_CONTACT_EMAIL.
# Everything else below is SERVER-ONLY and must never be in the app.

# --- Supabase ---------------------------------------------------------------
# Client-public (also needed by functions; Supabase injects these automatically
# into deployed edge functions).
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_ANON_KEY=your-public-anon-key
# SERVER-ONLY. Bypasses RLS. Injected automatically in deployed functions;
# only set it locally. Never put it in config/dev.json.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- AI providers (SERVER-ONLY) ---------------------------------------------
# Each provider has a "primary" and optional "secondary" key (alias). The
# secondary is used only when the primary is invalid or out of quota, and
# enables zero-downtime key rotation (see docs/AI_AGENT.md).
ANTHROPIC_API_KEY=sk-ant-REPLACE_ME
ANTHROPIC_API_KEY_SECONDARY=
OPENAI_API_KEY=sk-REPLACE_ME
OPENAI_API_KEY_SECONDARY=
GEMINI_API_KEY=REPLACE_ME
GEMINI_API_KEY_SECONDARY=

# Provider fallback order (only providers with keys are used).
AI_PROVIDER_ORDER=anthropic,openai,gemini
# Default model per provider (configuration, not hard-coded truth).
AI_DEFAULT_MODEL_ANTHROPIC=claude-sonnet-5-5
AI_DEFAULT_MODEL_OPENAI=gpt-5.4-mini
AI_DEFAULT_MODEL_GEMINI=gemini-3.8-flash
# Optional extra allowlisted models (comma-separated) per provider.
# AI_ALLOWED_MODELS_ANTHROPIC=claude-haiku-5-5,claude-opus-5-5
# Optional price table override (USD per 1M tokens), JSON:
# AI_PRICE_TABLE_JSON={"claude-sonnet-5-5":{"provider":"anthropic","in":2,"out":10}}
# Global monthly spend cap across all users (USD). Requests are refused at 100 %.
AI_MONTHLY_BUDGET_USD=10
# Per-user requests per minute for ai-chat.
AI_RATE_LIMIT_PER_MIN=30
# Optional Anthropic effort (low|medium|high); unset = model default.
# AI_ANTHROPIC_EFFORT=medium
# Optional overall server deadline per request in ms (default 45000).
# AI_TOTAL_DEADLINE_MS=45000

# --- Strava ------------------------------------------------------------------
# Client id is client-public (also in config/dev.json); the secret is
# SERVER-ONLY (used by the strava-oauth function).
STRAVA_CLIENT_ID=12345
STRAVA_CLIENT_SECRET=REPLACE_ME
