<?xml version="1.0" encoding="utf-8"?>
<!-- JARVIS Today widget, compact (2x2 / 3x2). Rendered by
     surfaces/WidgetRenderer.kt. Dashes only in the static preview. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/surf_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/surf_widget_bg"
    android:orientation="vertical"
    android:paddingStart="10dp"
    android:paddingTop="8dp"
    android:paddingEnd="10dp"
    android:paddingBottom="8dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <LinearLayout
            android:id="@+id/surf_cell_steps"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginEnd="3dp"
            android:background="@drawable/surf_cell_bg"
            android:gravity="center_vertical"
            android:orientation="vertical"
            android:paddingStart="4dp"
            android:paddingTop="2dp"
            android:paddingEnd="4dp"
            android:paddingBottom="3dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:drawableStart="@drawable/surf_dot_steps"
                    android:drawablePadding="4dp"
                    android:ellipsize="end"
                    android:fontFamily="sans-serif-condensed"
                    android:letterSpacing="0.12"
                    android:singleLine="true"
                    android:text="STEPS"
                    android:textColor="@color/surf_text_muted"
                    android:textSize="8.5sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/surf_tgt_steps"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-condensed"
                    android:singleLine="true"
                    android:text=""
                    android:textColor="@color/surf_text_muted"
                    android:textSize="8.5sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/surf_val_steps"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="sans-serif-medium"
                android:includeFontPadding="false"
                android:paddingTop="1dp"
                android:singleLine="true"
                android:text="@string/surf_dash"
                android:textColor="@color/surf_text"
                android:textSize="15sp" />

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="3dp"
                android:layout_marginTop="3dp">

                <ProgressBar
                    android:id="@+id/surf_bar_steps"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="3dp"
                    android:indeterminate="false"
                    android:max="1000"
                    android:progress="0"
                    android:progressDrawable="@drawable/surf_bar_cyan" />

                <ProgressBar
                    android:id="@+id/surf_barg_steps"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="3dp"
                    android:indeterminate="false"
                    android:max="1000"
                    android:progress="1000"
                    android:progressDrawable="@drawable/surf_bar_gold"
                    android:visibility="gone" />
            </FrameLayout>
        </LinearLayout>
        <LinearLayout
            android:id="@+id/surf_cell_protein"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@drawable/surf_cell_bg"
            android:gravity="center_vertical"
            android:orientation="vertical"
            android:paddingStart="4dp"
            android:paddingTop="2dp"
            android:paddingEnd="4dp"
            android:paddingBottom="3dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:drawableStart="@drawable/surf_dot_protein"
                    android:drawablePadding="4dp"
                    android:ellipsize="end"
                    android:fontFamily="sans-serif-condensed"
                    android:letterSpacing="0.12"
                    android:singleLine="true"
                    android:text="PROT"
                    android:textColor="@color/surf_text_muted"
                    android:textSize="8.5sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/surf_tgt_protein"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-condensed"
                    android:singleLine="true"
                    android:text=""
                    android:textColor="@color/surf_text_muted"
                    android:textSize="8.5sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/surf_val_protein"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="sans-serif-medium"
                android:includeFontPadding="false"
                android:paddingTop="1dp"
                android:singleLine="true"
                android:text="@string/surf_dash"
                android:textColor="@color/surf_text"
                android:textSize="15sp" />

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="3dp"
                android:layout_marginTop="3dp">

                <ProgressBar
                    android:id="@+id/surf_bar_protein"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="3dp"
                    android:indeterminate="false"
                    android:max="1000"
                    android:progress="0"
                    android:progressDrawable="@drawable/surf_bar_cyan" />

                <ProgressBar
                    android:id="@+id/surf_barg_protein"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="3dp"
                    android:indeterminate="false"
                    android:max="1000"
                    android:progress="1000"
                    android:progressDrawable="@drawable/surf_bar_gold"
                    android:visibility="gone" />
            </FrameLayout>
        </LinearLayout>
    </LinearLayout>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="2dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <LinearLayout
            android:id="@+id/surf_cell_kcal"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginEnd="3dp"
            android:background="@drawable/surf_cell_bg"
            android:gravity="center_vertical"
            android:orientation="vertical"
            android:paddingStart="4dp"
            android:paddingTop="2dp"
            android:paddingEnd="4dp"
            android:paddingBottom="3dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:drawableStart="@drawable/surf_dot_calories"
                    android:drawablePadding="4dp"
                    android:ellipsize="end"
                    android:fontFamily="sans-serif-condensed"
                    android:letterSpacing="0.12"
                    android:singleLine="true"
                    android:text="KCAL"
                    android:textColor="@color/surf_text_muted"
                    android:textSize="8.5sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/surf_tgt_kcal"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-condensed"
                    android:singleLine="true"
                    android:text=""
                    android:textColor="@color/surf_text_muted"
                    android:textSize="8.5sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/surf_val_kcal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="sans-serif-medium"
                android:includeFontPadding="false"
                android:paddingTop="1dp"
                android:singleLine="true"
                android:text="@string/surf_dash"
                android:textColor="@color/surf_text"
                android:textSize="15sp" />

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="3dp"
                android:layout_marginTop="3dp">

                <ProgressBar
                    android:id="@+id/surf_bar_kcal"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="3dp"
                    android:indeterminate="false"
                    android:max="1000"
                    android:progress="0"
                    android:progressDrawable="@drawable/surf_bar_cyan" />

                <ProgressBar
                    android:id="@+id/surf_barg_kcal"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="3dp"
                    android:indeterminate="false"
                    android:max="1000"
                    android:progress="1000"
                    android:progressDrawable="@drawable/surf_bar_gold"
                    android:visibility="gone" />
            </FrameLayout>
        </LinearLayout>
        <LinearLayout
            android:id="@+id/surf_cell_water"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@drawable/surf_cell_bg"
            android:gravity="center_vertical"
            android:orientation="vertical"
            android:paddingStart="4dp"
            android:paddingTop="2dp"
            android:paddingEnd="4dp"
            android:paddingBottom="3dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:drawableStart="@drawable/surf_dot_water"
                    android:drawablePadding="4dp"
                    android:ellipsize="end"
                    android:fontFamily="sans-serif-condensed"
                    android:letterSpacing="0.12"
                    android:singleLine="true"
                    android:text="WATER"
                    android:textColor="@color/surf_text_muted"
                    android:textSize="8.5sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/surf_tgt_water"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-condensed"
                    android:singleLine="true"
                    android:text=""
                    android:textColor="@color/surf_text_muted"
                    android:textSize="8.5sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/surf_val_water"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="sans-serif-medium"
                android:includeFontPadding="false"
                android:paddingTop="1dp"
                android:singleLine="true"
                android:text="@string/surf_dash"
                android:textColor="@color/surf_text"
                android:textSize="15sp" />

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="3dp"
                android:layout_marginTop="3dp">

                <ProgressBar
                    android:id="@+id/surf_bar_water"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="3dp"
                    android:indeterminate="false"
                    android:max="1000"
                    android:progress="0"
                    android:progressDrawable="@drawable/surf_bar_cyan" />

                <ProgressBar
                    android:id="@+id/surf_barg_water"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="3dp"
                    android:indeterminate="false"
                    android:max="1000"
                    android:progress="1000"
                    android:progressDrawable="@drawable/surf_bar_gold"
                    android:visibility="gone" />
            </FrameLayout>
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <LinearLayout
            android:id="@+id/surf_header"
            android:layout_width="0dp"
            android:layout_height="26dp"
            android:layout_weight="1"
            android:background="@drawable/surf_cell_bg"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="3dp">

            <ImageView
                android:layout_width="12dp"
                android:layout_height="12dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_stat_jarvis"
                android:tint="@color/surf_cyan" />

            <TextView
                android:id="@+id/surf_updated"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:fontFamily="monospace"
                android:singleLine="true"
                android:text="@string/surf_dash"
                android:textColor="@color/surf_text_muted"
                android:textSize="9.5sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/surf_water_btn"
            android:layout_width="wrap_content"
            android:layout_height="26dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/surf_btn_water"
            android:contentDescription="@string/surf_water_button_cd"
            android:drawableStart="@drawable/ic_surf_water"
            android:drawablePadding="4dp"
            android:drawableTint="@color/surf_navy"
            android:fontFamily="sans-serif-medium"
            android:gravity="center"
            android:paddingStart="8dp"
            android:paddingEnd="10dp"
            android:singleLine="true"
            android:text="@string/surf_water_button"
            android:textColor="@color/surf_navy"
            android:textSize="11.5sp"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
